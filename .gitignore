# RSR — gitignore

# Secrets — NEVER commit these
.env
*.key

# Python
__pycache__/
*.py[cod]
*.pyo
.Python
*.egg-info/
dist/
build/
.eggs/
venv/
.venv/
env/

# Data — large files, regenerated by fetch scripts
data/raw/
data/processed/
data/sentiment/

# Model weights — large binary files
models/saved/*.pt
models/saved/*.zip

# Portfolio state — keep locally, sync via cloud cache
# data/portfolio.json   ← un-comment if you DON'T want to track portfolio in git

# Plots — generated output
plots/*.png

# Logs
logs/*.log

# IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# PyTorch / ML
*.onnx
runs/          # TensorBoard logs
