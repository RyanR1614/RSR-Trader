# RSR — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file to git.

# ── NewsAPI (free tier: newsapi.org) ──────────────────────────────────────────
# Register at https://newsapi.org/register
NEWSAPI_KEY=your_newsapi_key_here

# ── Reddit (free: reddit.com/prefs/apps) ──────────────────────────────────────
# Create a "script" app at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_SECRET=your_reddit_secret

# ── Alpha Vantage (optional, free tier: alphavantage.co) ─────────────────────
AV_KEY=your_alpha_vantage_key_here
